/dts-v1/;
#include <st/g4/stm32g431Xb.dtsi>
#include <st/g4/stm32g431r(6-8-b)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/dma/stm32_dma.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	model = "foc_motor STM32G431RB controller";
	compatible = "foc-motor";

	/*
	 * RM0440, memory map and embedded SRAM (DS12589 section 3.5 also
	 * confirms the addresses/sizes): the 10 KiB CCM code window uses
	 * the CPU I-code/D-code buses with zero wait states. DMA must
	 * not use this 0x10000000 window; keep all DMA buffers in sram0.
	 */
	ccm: memory@10000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x10000000 DT_SIZE_K(10)>;
		zephyr,memory-region = "CCM";
	};

	chosen {
		zephyr,console = &usart3;
		zephyr,shell-uart = &usart3;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	/*
	 * HW-ENC-007 harness as built: encoder CN2-4 Z -> U7-3 PB3, rising edge
	 * once per turn. PB3 is also TRACESWO; only SWD is used, so the SWO
	 * trace output is unavailable while this pin is the Z input.
	 */
	zephyr,user {
		encoder-z-gpios = <&gpiob 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	};
};

/*
 * RM0440, embedded SRAM; DS12589 section 3.5: SRAM1 = 16 KiB, SRAM2 =
 * 6 KiB. The remaining 10 KiB of upstream sram0 is the CCM alias at
 * 0x20005800 (accessible to DMA through the System bus). Exclude that
 * alias so stacks, data and DMA cannot overlap CCM code.
 */
&sram0 {
	reg = <0x20000000 DT_SIZE_K(22)>;
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

&pll {
	div-m = <4>;
	mul-n = <85>;
	div-p = <7>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(170)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

&gpioa {
	status = "okay";

	sd4_hog: motor-shutdown-d {
		gpio-hog;
		gpios = <0 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "SD4";
	};

	sd2_hog: motor-shutdown-b {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "SD2";
	};

	sd3_hog: motor-shutdown-c {
		gpio-hog;
		gpios = <2 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "SD3";
	};
};

&gpiob {
	status = "okay";

	sd1_hog: motor-shutdown-a {
		gpio-hog;
		gpios = <0 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "SD1";
	};
};

/* HW-UART-003: H2 pin 6 TX/PB10, pin 5 RX/PB11, pin 1 GND. */
&usart3 {
	pinctrl-0 = <&usart3_tx_pb10 &usart3_rx_pb11>;
	pinctrl-names = "default";
	current-speed = <921600>;
	interrupts = <39 5>;
	dmas = <&dmamux1 2 29 (STM32_DMA_PERIPH_TX | STM32_DMA_PRIORITY_LOW)>;
	dma-names = "tx";
	status = "okay";
};

/*
 * HW-ENC-005/007: encoder A -> PB4 TIM3_CH1, B -> PB5 TIM3_CH2 (AF2). The
 * KTH7823 holds A/B/Z high at power-up, so the pull-ups match its idle level
 * and keep the inputs defined while the harness is unplugged.
 */
&tim3_ch1_pb4 {
	bias-pull-up;
};

&tim3_ch2_pb5 {
	bias-pull-up;
};

&timers3 {
	status = "okay";

	encoder: qdec {
		compatible = "st,stm32-qdec";
		pinctrl-0 = <&tim3_ch1_pb4 &tim3_ch2_pb5>;
		pinctrl-names = "default";
		/* x4: count every A and B edge, 1024 A/B periods -> 4096 counts per turn (HW-ENC-003). */
		st,encoder-mode = <0x3>;
		/* 8 samples at 170 MHz = 47 ns, well below the edge spacing at motor speed. */
		st,input-filter-level = <3>;
		st,counts-per-revolution = <4096>;
		status = "okay";
	};
};

/*
 * TIM1, ADC2 and DMA2 stay disabled here on purpose: src/pwm_adc.c drives
 * them directly (TIM1 outputs off, ADC2 [IA, IC] on TIM1 TRGO2, DMA2
 * channel 1), so no Zephyr driver or pinctrl may claim them. PC0-PC3 keep
 * their reset analog mode (HW-PWM-009).
 */

&exti {
	/* Same level as the other drivers; the FOC ISR is the only planned zero-latency IRQ. */
	interrupts = <6 5>, <7 5>, <8 5>, <9 5>, <10 5>, <23 5>, <40 5>;
};

&dma1 {
	interrupts = <11 5>, <12 5>, <13 5>, <14 5>, <15 5>, <16 5>;
	status = "okay";
};

&dmamux1 {
	status = "okay";
};
