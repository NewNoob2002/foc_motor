CompileFlags:
  CompilationDatabase: build/arm
  Remove:
    - -fno-printf-return-value
    - -mfp16-format=ieee
    - -fno-reorder-functions
---
# lib/foc is not in the firmware build yet; the host tests compile it.
If:
  PathMatch: (lib/foc|tests/host/foc)/.*
CompileFlags:
  CompilationDatabase: build/host
